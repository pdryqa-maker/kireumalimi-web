# 이 파일을 복사해 .env.local을 만들고 값을 채웁니다. .env.local은 공유하거나 커밋하지 않습니다.
OPINET_API_KEY=
ANTHROPIC_API_KEY=
# 한국도로공사 공공데이터 포털(data.ex.co.kr) 인증키. 고속도로 휴게소 주유소 가격에 쓴다.
EX_API_KEY=
# 계정(아이디 로그인) 저장소. Vercel Storage에서 Upstash Redis를 연결하면 이 둘이 자동으로 들어간다(UPSTASH_REDIS_REST_URL·_TOKEN도 읽는다).
# 로컬에서 비워 두면 .data/ 폴더에 저장해 준비 없이 가입·로그인을 시험할 수 있다. 운영은 이 둘과 AUTH_SECRET이 모두 있어야 로그인이 켜진다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 로그인 세션 쿠키 서명 키. `openssl rand -base64 32`로 만든 32자 이상 값. 바꾸면 모두 로그아웃된다.
AUTH_SECRET=
